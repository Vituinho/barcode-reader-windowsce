# Railway: set these as service variables (DATABASE_URL as a reference to the Postgres service).
# Locally: copy to .env.

# postgres://, postgresql:// and postgresql+psycopg:// URLs are all accepted
DATABASE_URL=postgresql+psycopg://givova:change-me@localhost:5432/givova
# Long random string. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Exact admin web origin (scheme + host, no path, no trailing slash). Comma separated if several.
ADMIN_WEB_ORIGIN=http://localhost:3000

# Used only by the manual seed command: python -m app.seed
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=

# Optional (defaults shown)
ACCESS_TOKEN_EXPIRE_MINUTES=720
APP_TIMEZONE=America/Sao_Paulo
DUPLICATE_WINDOW_SECONDS=2
DEVICE_SYNC_INTERVAL_SECONDS=5
DEVICE_ONLINE_THRESHOLD_SECONDS=120
# Register an unknown deviceId automatically on first authenticated login
AUTO_REGISTER_DEVICES=true
# Homologation tool (Configurações > Manutenção). Set false before real production use.
ALLOW_OPERATIONAL_RESET=true
